{
  // Example only: copy to a local, ignored wrangler.jsonc after environment review.
  "name": "gestcsi-e05-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gestcsi-e05-staging",
    "database_id": "REPLACE_WITH_STAGING_D1_ID",
    "migrations_dir": "migrations"
  }],
  "vars": { "BRIDGE_ENABLED": "0" },
  "observability": { "enabled": true }
}
